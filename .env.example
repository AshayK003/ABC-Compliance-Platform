# ABC Compliance Platform — Environment Template
# Copy to .env and fill in values. NEVER commit .env to version control.

# Database (PostgreSQL with asyncpg driver)
# Local Docker Compose: postgresql+asyncpg://abc:abc@localhost:5432/abc_dashboard
# Production: use managed Postgres (Neon, Supabase, RDS) with connection pooling
DATABASE_URL=postgresql+asyncpg://abc:abc@localhost:5432/abc_dashboard

# Redis (for Celery worker when built — P2)
REDIS_URL=redis://localhost:6379/0

# Security — GENERATE A STRONG RANDOM KEY FOR PRODUCTION
# Run: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-strong-secret-key-here

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — frontend origin(s)
# Local: http://localhost:5173
# Production: your Vercel/Render domain
ALLOWED_ORIGINS=http://localhost:5173

# Debug mode (development only)
DEBUG=true