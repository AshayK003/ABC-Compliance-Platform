# ABC Compliance Platform — Environment Template
# Copy to .env and fill in values. NEVER commit .env to version control.

# Database (PostgreSQL with asyncpg driver)
# Local Docker Compose: postgresql+asyncpg://abc:abc@localhost:5432/abc_dashboard
# Production (Neon): use the POOLED connection string (-pooler host) so the
#   app's 20-connection pool multiplexes over Neon's pgbouncer. Drop
#   sslmode/channel_binding params — asyncpg needs ssl=require instead.
#   Example: postgresql+asyncpg://user:pass@ep-x-pooler.region.aws.neon.tech/db?ssl=require
DATABASE_URL=postgresql+asyncpg://abc:abc@localhost:5432/abc_dashboard

# Redis (for Celery worker when built — P2)
REDIS_URL=redis://localhost:6379/0

# Security — GENERATE A STRONG RANDOM KEY FOR PRODUCTION
# Run: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-strong-secret-key-here

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — frontend origin(s), JSON list format (pydantic-settings requirement)
# Local: ["http://localhost:5173"]
# Production: ["https://your-vercel-domain.vercel.app"]
ALLOWED_ORIGINS=["http://localhost:5173"]

# Debug mode (development only)
DEBUG=true